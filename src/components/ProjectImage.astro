---
/**
 * 16:9 project screenshot. Only rendered for a configured, build-validated image.
 * If the file still fails to load in the browser, the frame hides itself (no broken-image icon).
 */
import type { ProjectImage } from '../config/projects';

interface Props {
  image: ProjectImage;
  class?: string;
}

const { image, class: className } = Astro.props;
---

<div class:list={['project-image', className]}>
  <img
    src={image.src}
    alt={image.alt}
    width="1280"
    height="720"
    loading="lazy"
    decoding="async"
    style={`object-position: ${image.position ?? 'center'}`}
    onerror="this.parentElement.hidden = true"
  />
</div>

<style>
  .project-image {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-ink-2);
  }
  .project-image[hidden] {
    display: none;
  }
  .project-image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Subtle fade into the card at the bottom edge */
  .project-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 58%, rgb(18 22 40 / 0.85) 100%);
    pointer-events: none;
  }
</style>
