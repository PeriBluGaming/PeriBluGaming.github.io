---
/**
 * Project screenshot that fills its (positioned, sized) container with object-fit: cover.
 * Only rendered for a configured, build-validated image.
 * If the file still fails to load in the browser, the frame hides itself (no broken-image icon).
 */
import type { ProjectImage } from '../config/projects';

interface Props {
  image: ProjectImage;
  class?: string;
}

const { image, class: className } = Astro.props;
---

<div class:list={['project-image', className]}>
  <img
    src={image.src}
    alt={image.alt}
    width="1280"
    height="720"
    loading="lazy"
    decoding="async"
    style={`object-position: ${image.position ?? 'center'}`}
    onerror="this.parentElement.hidden = true"
  />
</div>

<style>
  .project-image {
    overflow: hidden;
    background: var(--color-ink-2);
  }
  .project-image[hidden] {
    display: none;
  }
  .project-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
