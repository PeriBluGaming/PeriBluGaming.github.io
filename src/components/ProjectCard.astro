---
import type { Project } from '../lib/projects';
import { formatCount, formatDate } from '../lib/format';
import Icon from './Icon.astro';
import PlatformArt from './PlatformArt.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const titleId = `project-${project.name.toLowerCase()}`;
---

<article class:list={['project-card', `accent-${project.category.accent}`]} aria-labelledby={titleId}>
  <div class="flex items-start justify-between gap-4">
    <div class="project-icon">
      {
        project.image ? (
          <img src={project.image.src} alt="" loading="lazy" decoding="async" class="size-full rounded-md object-cover" />
        ) : (
          <PlatformArt kind={project.category.art} class="w-full" />
        )
      }
    </div>
    <p class="pt-1 text-right text-[0.7rem] font-semibold tracking-[0.14em] text-muted uppercase">
      {project.category.label}
    </p>
  </div>

  <h3 id={titleId} class="mt-4 text-lg leading-tight font-bold">{project.title}</h3>

  {
    (project.tags.length > 0 || project.fork || project.archived) && (
      <ul class="mt-2.5 flex flex-wrap gap-2" aria-label="Tags">
        {project.tags.map((tag) => (
          <li class="tag">{tag}</li>
        ))}
        {project.fork && (
          <li class="flag">
            <Icon name="fork" class="size-3" />
            Fork
          </li>
        )}
        {project.archived && <li class="flag">Archived</li>}
      </ul>
    )
  }

  {project.description && <p class="mt-3 line-clamp-3 text-sm leading-[1.5] text-muted">{project.description}</p>}

  <div class="mt-auto pt-5">
    <p class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs font-medium text-muted">
      {
        project.language && (
          <span class="inline-flex items-center gap-1.5">
            <span class="size-2 rounded-full bg-[var(--accent)]" aria-hidden="true" />
            {project.language}
          </span>
        )
      }
      <span class="inline-flex items-center gap-1">
        <Icon name="star" class="size-3.5" />
        {formatCount(project.stars)}
        <span class="sr-only">stars</span>
      </span>
      <span class="inline-flex items-center gap-1">
        <Icon name="clock" class="size-3.5" />
        <span class="sr-only">Last updated</span>
        <time datetime={project.pushedAt}>{formatDate(project.pushedAt)}</time>
      </span>
    </p>

    <a href={project.url} class="link-arrow stretched mt-4 text-[0.95rem]" target="_blank" rel="noopener">
      <Icon name="github" class="size-5 text-white" />
      Repository
      <Icon name="arrow-right" class="size-4" />
      <span class="sr-only">: {project.title} on GitHub (opens in a new tab)</span>
    </a>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.4rem 1.4rem 1.3rem;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-line);
    background: linear-gradient(180deg, #131729 0%, #0e1121 100%);
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  /* Subtle accent line */
  .project-card::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 1.4rem;
    width: 3rem;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
  }
  .project-card:hover,
  .project-card:focus-within {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 70%, transparent);
    box-shadow: 0 0 20px color-mix(in srgb, var(--accent) 20%, transparent);
  }

  .project-icon {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 3rem;
  }

  .flag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 2px 7px;
    border-radius: 5px;
    border: 1px solid var(--color-line);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-muted);
  }
</style>
