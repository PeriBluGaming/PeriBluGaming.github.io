---
/** Section wrapper for detail pages: shared heading style (SectionHeading) and spacing. */
import SectionHeading from '../SectionHeading.astro';

interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section class="mt-16 sm:mt-20" aria-labelledby={id}>
  <SectionHeading id={id} title={title} />
  <div class="mt-8">
    <slot />
  </div>
</section>
