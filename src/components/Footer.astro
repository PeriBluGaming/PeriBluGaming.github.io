---
import { activeSocials, site } from '../config/site';
import Icon from './Icon.astro';

const socials = activeSocials();
const year = new Date().getFullYear();
---

<footer class="mt-10 border-t border-white/8">
  <div class="container-site flex flex-col items-center gap-6 py-8 sm:flex-row sm:gap-0">
    <a href="/" class="shrink-0 rounded-md" aria-label={`${site.name} – back to top`}>
      <img
        src="/images/logo-wordmark.webp"
        alt=""
        width="360"
        height="242"
        loading="lazy"
        decoding="async"
        class="h-[72px] w-auto"
      />
    </a>

    <div class="text-center sm:ml-10 sm:border-l sm:border-white/15 sm:pl-10 sm:text-left">
      <p class="text-lg font-bold">{site.name}</p>
      <p class="mt-1 text-sm text-muted">{site.tagline}</p>
      <p class="mt-2 text-xs text-muted/80">© <span data-year>{year}</span> {site.name}. All rights reserved.</p>
    </div>

    <ul class="flex items-center gap-5 sm:ml-auto" aria-label="Social media">
      {
        socials.map((s) => (
          <li>
            <a href={s.url} class="grid place-items-center p-1 text-white transition-colors hover:text-neon-cyan" target="_blank" rel="noopener">
              <Icon name={s.id} class="size-7" />
              <span class="sr-only">{s.label} (opens in a new tab)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="container-site pb-6" aria-hidden="true">
    <div class="footer-line"></div>
  </div>
</footer>

<script>
  // Keep the copyright year current even if the static build is older.
  document.querySelectorAll('[data-year]').forEach((el) => (el.textContent = String(new Date().getFullYear())));
</script>

<style>
  .footer-line {
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, transparent 0%, var(--color-neon-pink) 18%, var(--color-neon-violet) 50%, var(--color-neon-cyan) 82%, transparent 100%);
    opacity: 0.7;
  }
</style>
