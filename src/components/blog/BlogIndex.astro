---
/** Post grid with category links. Shared by /blog/ and /blog/category/<id>/. Works without JavaScript. */
import type { BlogCategory } from '../../config/blog';
import type { BlogData, Post } from '../../lib/blog';
import SectionHeading from '../SectionHeading.astro';
import BlogCard from './BlogCard.astro';

interface Props {
  title: string;
  intro: string;
  /** Posts shown on this page. */
  posts: Post[];
  /** All published posts (for the filter counts). */
  allPosts: Post[];
  /** All categories that have posts. */
  categories: BlogCategory[];
  current?: BlogCategory['id'];
  status: BlogData['status'];
}

const { title, intro, posts, allPosts, categories, current, status } = Astro.props;
const countFor = (id: string) => allPosts.filter((p) => p.category.id === id).length;
---

<section class="container-site pb-16" aria-labelledby="blog-title">
  <SectionHeading id="blog-title" title={title} count={posts.length > 0 ? posts.length : undefined} />
  <p class="mt-4 max-w-2xl text-muted">{intro}</p>

  {
    categories.length > 1 && (
      <nav class="filters mt-8" aria-label="Blog categories">
        <a href="/blog/" class="filter" aria-current={current ? undefined : 'page'}>
          All <span class="filter-count">{allPosts.length}</span>
        </a>
        {categories.map((c) => (
          <a href={`/blog/category/${c.id}/`} class="filter" aria-current={current === c.id ? 'page' : undefined}>
            {c.label} <span class="filter-count">{countFor(c.id)}</span>
          </a>
        ))}
      </nav>
    )
  }

  {
    posts.length > 0 ? (
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <li>
            <BlogCard post={post} />
          </li>
        ))}
      </ul>
    ) : (
      <div class="empty mt-10">
        <p class="text-lg font-bold">{status === 'unavailable' ? 'Posts are temporarily unavailable.' : 'No posts yet.'}</p>
        <p class="mt-2 text-muted">
          Devlogs, news and release notes will show up here. Until then, have a look at the{' '}
          <a href="/#projects" class="link-arrow">projects</a>.
        </p>
      </div>
    )
  }
</section>

<style>
  /* Same pill style as the project filters, as real links */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: var(--color-ink-2);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-muted);
    transition:
      color 0.2s,
      border-color 0.2s,
      background-color 0.2s;
  }
  .filter:hover {
    color: #fff;
    border-color: #39415c;
  }
  .filter[aria-current='page'] {
    color: #fff;
    border-color: var(--color-neon-cyan);
    background: rgb(35 217 245 / 0.1);
  }
  .filter-count {
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  .filter[aria-current='page'] .filter-count {
    color: var(--color-neon-cyan);
  }

  .empty {
    padding: 2rem 1.5rem;
    border-radius: var(--radius-card);
    border: 1px dashed var(--color-line);
    background: rgb(14 17 33 / 0.6);
    text-align: center;
  }
</style>
