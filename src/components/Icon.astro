  code: { viewBox: '0 0 24 24', body: '<path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/>' },
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  class?: string;
  label?: string;
}

const { name, class: className = 'size-5', label } = Astro.props;
const icon = icons[name];
const filled = 'fill' in icon && icon.fill;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={icon.viewBox}
  class={className}
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? undefined : 'currentColor'}
  stroke-width={filled ? undefined : 2}
  stroke-linecap={filled ? undefined : 'round'}
  stroke-linejoin={filled ? undefined : 'round'}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={icon.body}
/>
