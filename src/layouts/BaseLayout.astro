---
import '../styles/global.css';
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
const ogImage = new URL('/images/og-image.jpg', Astro.site ?? site.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b0d19" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="PeriBluGaming logo in front of a synthwave sunset" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" as="image" href="/images/logo-wordmark.webp" type="image/webp" />
    <link
      rel="preload"
      as="image"
      href="/images/hero-synthwave.webp"
      type="image/webp"
      media="(min-width: 641px)"
    />
    <link
      rel="preload"
      as="image"
      href="/images/hero-synthwave-640.webp"
      type="image/webp"
      media="(max-width: 640px)"
    />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only-focusable fixed top-3 left-3 z-50 rounded-md bg-ink px-4 py-2 font-semibold text-neon-cyan ring-1 ring-neon-cyan"
      >Skip to content</a
    >
    <slot />
  </body>
</html>
