        "markDefs": [],
        "children": [
          {
            "_type": "span",
            "_key": "a3s1",
            "text": "PlayStation games were designed for a 4:3 picture. Stretching the image is easy, but a real widescreen mode needs a wider field of view, adjusted culling and HUD elements that stay in place. Longer paragraphs like this one show how body text reads at a comfortable line length on desktop and on phones.",
            "marks": []
          }
        ]
      },
