      },
      {
        "_type": "block",
        "_key": "a5",
        "style": "normal",
        "listItem": "bullet",
        "level": 1,
        "markDefs": [],
        "children": [{ "_type": "span", "_key": "a5s1", "text": "Frustum culling that no longer hides objects at the edges", "marks": [] }]
      },
      {
        "_type": "block",
        "_key": "a6",
        "style": "normal",
        "listItem": "bullet",
        "level": 1,
        "markDefs": [],
        "children": [{ "_type": "span", "_key": "a6s1", "text": "HUD anchored to the screen corners", "marks": [] }]
      },
