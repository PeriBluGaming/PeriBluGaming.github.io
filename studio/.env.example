# Copy to studio/.env (never commit it). Variables prefixed with SANITY_STUDIO_ are bundled into the
# PUBLIC Studio app by design – put only public values here, never tokens (sanity.cli.ts refuses token-like names).
# The project ID is not a secret; it identifies the project like a username.
SANITY_STUDIO_PROJECT_ID=hyyn359x
SANITY_STUDIO_DATASET=production
