{
  "name": "periblugaming-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "snapshot": "node scripts/update-fallback.ts",
    "migrate:projects:dry-run": "node --env-file-if-exists=.env scripts/sanity-project-migration-dry-run.ts",
    "migrate:projects:preflight": "node --env-file-if-exists=.env scripts/sanity-project-migration.ts preflight",
    "migrate:projects:execute": "node --env-file-if-exists=.env scripts/sanity-project-migration.ts execute",
    "test": "node --test \"tests/**/*.test.ts\"",
    "validate:dist": "node scripts/validate-dist.ts",
    "astro": "astro"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@sanity/client": "^8.14.1",
    "@sanity/image-url": "^2.1.1",
    "astro": "^7.4.4",
    "astro-portabletext": "^1.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
