# All variables are read at BUILD TIME only and are never exposed to the browser.
# Copy to .env for local development. Never commit .env or real tokens.

# ── GitHub ──────────────────────────────────────────────────────────────────────
# Optional. Only used at build time to raise the GitHub API rate limit (60 -> 5000 req/h).
# Never commit a real token. A fine-grained token without any permissions is sufficient.
GITHUB_TOKEN=

# Optional. Set to 1 to skip the GitHub API and build from src/data/fallback-repos.json.
GITHUB_OFFLINE=

# ── Blog (Sanity CMS) ─ see docs/sanity-setup.md ───────────────────────────────
# Unset = blog not configured: no posts and no "Blog" menu item. Not an error.
# The project ID is not a secret (it is part of every image URL), but keep it out of Git anyway.
SANITY_PROJECT_ID=

# Optional. Default: production
SANITY_DATASET=

# Optional. Pinned API version (a date). Default: 2025-02-19
SANITY_API_VERSION=

# Optional, SECRET. Only needed if the dataset is private. Use a "Viewer" (read-only) token.
SANITY_READ_TOKEN=

# Optional. 1 = if Sanity is unreachable, build WITHOUT posts instead of failing the build.
# Leave unset for production: a failed build keeps the previous deployment (and its posts) online.
SANITY_ALLOW_FAILURE=

# Optional. 1 = use local sample posts from src/data/sample-posts.json (local development only;
# refused in CI). Overrides the Sanity settings above.
BLOG_SAMPLE=
